{
  // The site's Worker: static files from out/ plus the editor API (worker/index.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douglas-construction-site",
  // The client's Cloudflare account (Porcinollc@gmail.com's Account). Pinned so Wrangler
  // never creates or deploys anything in another account the signed-in user can see.
  "account_id": "ad5d62a9e75ee9245948edbf271b0d30",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the Worker: it guards the editor, serves /api and /media, and
    // while the site is a preview (site-path.json) sends unknown addresses to the placeholder.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "douglas-site",
      "database_id": "b9438381-61ea-4c48-b61e-db6c369af858",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "douglas-site-media" }],
  "vars": {
    // Filled in once Cloudflare Access is set up (Zero Trust > Access > Applications).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secrets (wrangler secret put): DEPLOY_HOOK_URL, BUILD_TOKEN.
}
