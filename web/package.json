{
  "name": "douglas-construction-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "next build && node scripts/place-site.mjs",
    "build:cf": "node scripts/pull-content.mjs && next build && node scripts/place-site.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "mkdir -p .wrangler && node scripts/seed-content.mjs > .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "photoswipe": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  }
}
